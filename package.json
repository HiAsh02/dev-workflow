{
  "name": "dev-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Portable, evidence-driven software development workflows for coding agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dev-workflow": "./bin/dev-workflow.mjs"
  },
  "pi": {
