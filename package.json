    "test:scenario": "node scripts/run-tests.mjs tests/scenario",
    "pack": "node scripts/package.mjs",
    "verify:dist": "node scripts/check-source-sync.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.7.0"
  }
}
